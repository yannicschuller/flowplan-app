{
  "name": "flowplan-app",
  "productName": "Flowplan",
  "version": "1.0.0",
  "description": "Flowplan as an app for iPhone, iPad and Android",
  "private": true,
  "author": "Flowplan",
  "license": "AGPL-3.0-only",
  "homepage": "https://flowplan.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannicschuller/flowplan-app.git"
  },
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo/ui": "~58.0.18",
    "expo": "~58.0.11",
    "expo-application": "~58.1.1",
    "expo-audio": "~58.0.9",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.6",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.4",
    "expo-quick-actions": "^6.0.2",
    "expo-screen-capture": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.22.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --import tsx --test test/*.test.ts && node --check scripts/icons.mjs && node --check scripts/screenshots.mjs && node --check scripts/store-images.mjs && node --check scripts/devices.mjs && node --check scripts/frame.mjs && node --check scripts/preview-video.mjs && node --check scripts/store-mockups.mjs && node --check scripts/store-style.mjs && node --check scripts/store-flowplan.mjs",
    "prebuild": "expo prebuild --clean --no-install",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "expo prebuild --clean --platform ios && xcodebuild -workspace ios/Flowplan.xcworkspace -scheme Flowplan -configuration Release -sdk iphonesimulator -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build",
    "build:android": "expo prebuild --clean --platform android && cd android && ./gradlew assembleDebug",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "store:images": "node scripts/store-images.mjs",
    "preview": "node scripts/preview-video.mjs"
  }
}
