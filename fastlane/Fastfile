# Builds and uploads for the stores. Every lane works from the repository
# root after `npm ci && npx expo prebuild` (plus `pod install` for iOS);
# credentials come from the environment (README → Signing lists every secret):
#
#   fastlane ios setup        App IDs, certificate and profiles (match), and
#                             the store listing – once and whenever needed,
#                             from Actions → iOS setup (ios-setup.yml)
#   fastlane ios build        signed App Store build (ios/build/Flowplan.ipa)
#   fastlane ios beta         … and upload it to TestFlight
#   fastlane ios metadata     texts, screenshots and age rating from store/app-store
#   fastlane ios creative     product page header and search results image
#                             (store/app-store/creative) onto the version
#   fastlane android build    signed bundle and APK (android/app/build/outputs)
#   fastlane android internal … and upload it to Play's internal testing track
#   fastlane android metadata texts and images from store/google-play
#
# Without credentials the build workflow builds unsigned instead (no fastlane).
# The iOS app has four targets: the app (app.flowplan.mobile), its widgets
# and Live Activity (app.flowplan.mobile.widgets), the share extension
# (app.flowplan.mobile.share) and the Notification Service Extension of the
# push relay (app.flowplan.mobile.notifications), all in the App Group
# group.app.flowplan.mobile.

require "digest"
require "json"
require "securerandom"

ROOT = File.expand_path("..", __dir__)
BUNDLE_ID = "app.flowplan.mobile"
WIDGETS_ID = "#{BUNDLE_ID}.widgets"
SHARE_ID = "#{BUNDLE_ID}.share"
NOTIFICATIONS_ID = "#{BUNDLE_ID}.notifications"
APP_GROUP = "group.#{BUNDLE_ID}"
# Every target of the Xcode project that app.config.ts generates, with what
# its App ID needs in the developer portal: the app (push, App Group) and the
# widgets and Live Activity extension (App Group; the Live Activities' push
# tokens are the app's, under its push capability) – which also holds the configurable widgets,
# controls and their App Intents (plugins/with-widget-suite.js), and whose
# keychain items use the App Group as access group – and the share extension
# (plugins/with-capture.js: App Group, reads that keychain item) and the
# Notification Service Extension (plugins/with-notification-service.js: App
# Group, whose keychain holds the push relay's keys; no push capability of
# its own). The document scanner and Spotlight need no capability. No Associated Domains, iCloud or Sign in with Apple. A new
# target or capability in app.config.ts belongs here too.
IOS_TARGETS = [
  { target: "Flowplan", bundle_id: BUNDLE_ID, name: "Flowplan", capabilities: %w[APP_GROUPS PUSH_NOTIFICATIONS] },
  { target: "ExpoWidgetsTarget", bundle_id: WIDGETS_ID, name: "Flowplan Widgets", capabilities: %w[APP_GROUPS] },
  { target: "FlowplanShare", bundle_id: SHARE_ID, name: "Flowplan Share", capabilities: %w[APP_GROUPS] },
  { target: "FlowplanNotifications", bundle_id: NOTIFICATIONS_ID, name: "Flowplan Notifications", capabilities: %w[APP_GROUPS] },
].freeze
# Certificate and profiles of fastlane match: a private repository, encrypted
# with MATCH_PASSWORD (store/README.md → One-click setup).
MATCH_GIT_URL = ENV.fetch("MATCH_GIT_URL", "https://github.com/yannicschuller/flowplan-certificates.git")
# What App Store Connect asks for when the app record is created by hand
# (the API cannot create it).
SKU = "flowplan-ios"
PRIMARY_LOCALE = "en-US"
KEYCHAIN = "flowplan-build"
KEYCHAIN_PASSWORD = SecureRandom.hex(16)

def env!(name)
  value = ENV[name].to_s
  UI.user_error!("Missing #{name} (see README → Signing)") if value.empty?
  value
end

# A secret given as base64 or as plain text.
def decoded(name)
  value = env!(name).strip
  return value if value.start_with?("-----BEGIN", "{")
  require "base64"
  Base64.decode64(value)
end

platform :ios do
  def api_key
    @api_key ||= app_store_connect_api_key(
      key_id: env!("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: env!("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: decoded("APP_STORE_CONNECT_API_KEY"),
      in_house: false,
    )
  end

  # The key as a file, for xcodebuild's own sign-in (cloud signing).
  def api_key_file
    path = File.join(Dir.tmpdir, "AuthKey_#{env!("APP_STORE_CONNECT_API_KEY_ID")}.p8")
    File.write(path, decoded("APP_STORE_CONNECT_API_KEY"))
    path
  end

  # match is used when its secrets are there (MATCH_PASSWORD and
  # MATCH_GIT_BASIC_AUTHORIZATION, written by the iOS setup).
  def match?
    ENV["MATCH_PASSWORD"].to_s != "" && ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s != ""
  end

  # A keychain of its own for the certificate, not the default one: the build
  # runs on a Mac that is also used otherwise (README → Build machine).
  def build_keychain
    create_keychain(
      name: KEYCHAIN,
      password: KEYCHAIN_PASSWORD,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: true,
      add_to_search_list: true,
    )
  end

  def delete_build_keychain
    delete_keychain(name: KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db"))
  end

  # Apple Distribution certificate and App Store profiles of every target from
  # the certificates repository. Only the setup may create or renew them
  # (readonly: false); builds only read.
  def match_signing(readonly:, force: false)
    match(
      type: "appstore",
      platform: "ios",
      app_identifier: IOS_TARGETS.map { |t| t[:bundle_id] },
      api_key: api_key,
      team_id: env!("IOS_TEAM_ID"),
      storage_mode: "git",
      git_url: MATCH_GIT_URL,
      git_basic_authorization: env!("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: readonly,
      force: force,
      generate_apple_certs: true,
      keychain_name: KEYCHAIN,
      keychain_password: KEYCHAIN_PASSWORD,
      shallow_clone: true,
      verbose: false,
    )
  end

  def match_profile_name(bundle_id)
    ENV["sigh_#{bundle_id}_appstore_profile-name"].to_s
  end

  def match_profile_path(bundle_id)
    ENV["sigh_#{bundle_id}_appstore_profile-path"].to_s
  end

  # Manual signing of one target with a given profile.
  def sign_target(project, target, bundle_id, profile_name)
    update_code_signing_settings(
      path: project,
      targets: [target],
      use_automatic_signing: false,
      team_id: env!("IOS_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_id,
    )
  end

  desc "Signed App Store build"
  lane :build do
    api_key
    project = File.join(ROOT, "ios/Flowplan.xcodeproj")
    xcargs = ["-allowProvisioningUpdates"]
    export_options = {}
    if match?
      # Certificate and profiles from the certificates repository (match,
      # read-only): manual signing, one profile per target.
      UI.message("Signing with match (#{MATCH_GIT_URL})")
      build_keychain
      match_signing(readonly: true)
      IOS_TARGETS.each do |t|
        name = match_profile_name(t[:bundle_id])
        UI.user_error!("match installed no profile for #{t[:bundle_id]} – run Actions → iOS setup") if name.empty?
        sign_target(project, t[:target], t[:bundle_id], name)
        export_options[t[:bundle_id]] = name
      end
    elsif ENV["IOS_DISTRIBUTION_CERTIFICATE"].to_s != ""
      # Certificate and profiles from secrets: manual signing, one profile
      # per target.
      certificate = File.join(Dir.tmpdir, "distribution.p12")
      File.binwrite(certificate, decoded("IOS_DISTRIBUTION_CERTIFICATE"))
      build_keychain
      import_certificate(
        certificate_path: certificate,
        certificate_password: ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"].to_s,
        keychain_name: KEYCHAIN,
        keychain_password: KEYCHAIN_PASSWORD,
      )
      File.delete(certificate)
      profiles = {
        "Flowplan" => [BUNDLE_ID, "IOS_PROVISIONING_PROFILE", ENV.fetch("IOS_PROVISIONING_PROFILE_NAME", "Flowplan App Store")],
        "ExpoWidgetsTarget" => [WIDGETS_ID, "IOS_WIDGETS_PROVISIONING_PROFILE", ENV.fetch("IOS_WIDGETS_PROVISIONING_PROFILE_NAME", "Flowplan Widgets App Store")],
        "FlowplanShare" => [SHARE_ID, "IOS_SHARE_PROVISIONING_PROFILE", ENV.fetch("IOS_SHARE_PROVISIONING_PROFILE_NAME", "Flowplan Share App Store")],
        "FlowplanNotifications" => [NOTIFICATIONS_ID, "IOS_NOTIFICATIONS_PROVISIONING_PROFILE", ENV.fetch("IOS_NOTIFICATIONS_PROVISIONING_PROFILE_NAME", "Flowplan Notifications App Store")],
      }
      profiles.each do |target, (bundle_id, secret, name)|
        profile = File.join(Dir.tmpdir, "#{target}.mobileprovision")
        File.binwrite(profile, decoded(secret))
        install_provisioning_profile(path: profile)
        sign_target(project, target, bundle_id, name)
        export_options[bundle_id] = name
      end
    else
      # Only the API key: Xcode signs with cloud-managed certificates and
      # creates the App IDs, the App Group and the profiles itself.
      xcargs += [
        "-authenticationKeyPath #{api_key_file}",
        "-authenticationKeyID #{env!("APP_STORE_CONNECT_API_KEY_ID")}",
        "-authenticationKeyIssuerID #{env!("APP_STORE_CONNECT_API_ISSUER_ID")}",
        "DEVELOPMENT_TEAM=#{env!("IOS_TEAM_ID")}",
        "CODE_SIGN_STYLE=Automatic",
      ]
    end
    build_app(
      workspace: File.join(ROOT, "ios/Flowplan.xcworkspace"),
      scheme: "Flowplan",
      configuration: "Release",
      export_method: "app-store",
      export_options: export_options.empty? ? {} : { provisioningProfiles: export_options },
      output_directory: File.join(ROOT, "ios/build"),
      output_name: "Flowplan.ipa",
      xcargs: xcargs.join(" "),
      export_xcargs: "-allowProvisioningUpdates",
    )
  ensure
    delete_build_keychain
  end

  desc "Signed build to TestFlight (internal testers)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ROOT, "ios/build/Flowplan.ipa"),
      skip_waiting_for_build_processing: true,
      changelog: File.read(File.join(ROOT, "store/app-store/en-US/release_notes.txt")),
    )
  end

  # What App Review gets besides store/app-store/review_information/*.txt: the
  # demo account and the contact, from the environment and never from files in
  # the repository (store/README.md → App Review).
  def review_information
    values = {
      demo_user: ENV["DEMO_USER"],
      demo_password: ENV["DEMO_PASSWORD"],
      email_address: ENV["REVIEW_EMAIL"],
      phone_number: ENV["REVIEW_PHONE"],
    }.reject { |_, value| value.to_s.strip.empty? }
    UI.important("No DEMO_USER / DEMO_PASSWORD set: App Review gets no demo account from this upload.") unless values[:demo_user] && values[:demo_password]
    values
  end

  def package_version
    JSON.parse(File.read(File.join(ROOT, "package.json"))).fetch("version")
  end

  # Texts, categories, age rating, review information and (unless turned
  # off) screenshots for iPhone and iPad from store/app-store, for the
  # version in package.json. Submits for review only when asked.
  def upload_listing(screenshots: true, submit: false)
    review = review_information
    metadata = File.join(ROOT, "store/app-store")
    # deliver always reads the version's review details, and App Store
    # Connect only creates them together with a contact e-mail and phone.
    unless review[:email_address] && review[:phone_number]
      UI.user_error!("Set the secrets REVIEW_EMAIL and REVIEW_PHONE (international format, e.g. +49 151 2345678) – App Store Connect needs a review contact before the listing can be uploaded. DEMO_USER / DEMO_PASSWORD can follow later.")
    end
    deliver(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      platform: "ios",
      app_version: package_version,
      metadata_path: metadata,
      screenshots_path: File.join(metadata, "screenshots"),
      # The screenshots and the preview video live next to the locale folders.
      ignore_language_directory_validation: true,
      app_rating_config_path: File.join(metadata, "app_rating_config.json"),
      app_review_information: review,
      skip_binary_upload: true,
      skip_app_version_update: false,
      skip_screenshots: !screenshots,
      overwrite_screenshots: true,
      submit_for_review: submit,
      # A newer version replaces one still waiting for review (it would
      # block creating the new version otherwise); the newer one carries
      # its changes too.
      reject_if_possible: submit,
      # Released to everyone as soon as Apple approves it.
      automatic_release: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "App Store texts, screenshots and age rating (store/app-store); submitted for review with the iOS setup workflow's submit"
  lane :metadata do
    upload_listing
  end

  # ---- Creative assets (iOS 27: "Header and Search Results") ----
  #
  # store/app-store/creative/<locale>/{header,search-results}.png (npm run
  # store:creative) go into the app's Asset Library and onto the product page
  # of the version being edited, per language. fastlane has no action for the
  # Asset Library yet (App Store Connect API 4.5.1), so this talks to the API
  # directly with the key's token:
  #
  #   GET  /v1/apps/{id}/assetLibrary               the library
  #   GET  /v1/appAssetLibraryRefData               specs, placement groups, limits
  #   POST /v1/appAssetLibraryImages                reserve (category CREATIVE_ASSETS)
  #   PUT  uploadOperations[].url                   the bytes
  #   PATCH /v1/appAssetLibraryImages/{id}          uploaded: true, then wait for processing
  #   POST /v1/appAssetLibraryPlacements            PRODUCT_PAGE_HEADER_ASSET /
  #                                                 APP_STORE_SEARCH_RESULTS_ASSET on the
  #                                                 appStoreVersionLocalization
  #
  # Safe to run again: an image is found again by its reference name, which
  # holds a hash of the file, and a placement that already shows it is kept.
  # A placement with another image is replaced (the old image stays in the
  # Asset Library). The assets go to App Review with the version.
  CREATIVE = {
    "header" => "PRODUCT_PAGE_HEADER_ASSET",
    "search-results" => "APP_STORE_SEARCH_RESULTS_ASSET",
  }.freeze
  CREATIVE_READY = %w[PREPARE_FOR_SUBMISSION READY_FOR_REVIEW WAITING_FOR_REVIEW IN_REVIEW ACCEPTED APPROVED].freeze

  def asc
    api_key
    Spaceship::ConnectAPI.client.tunes_request_client
  end

  # Error message of a failed request, to tell "not allowed in this state" apart.
  def asc_error(error)
    error.message.to_s.lines.first.to_s.strip
  end

  def creative_ref_data
    @creative_ref_data ||= asc.get("v1/appAssetLibraryRefData", { fields: { appAssetLibraryRefData: "features,placementTypes,imageSpecs" } }).body["data"].first["attributes"]
  end

  # The image specification a file fits (Apple matches it again on processing).
  def creative_spec(placement_type, file)
    width, height = File.binread(file, 24)[16, 8].unpack("NN")
    spec = creative_ref_data["imageSpecs"].find do |s|
      d = s["dimensions"] || {}
      Array(s["compatiblePlacementTypes"]).include?(placement_type) &&
        Array(s["fileExtensions"]).include?(File.extname(file).downcase) &&
        width.between?(d["minWidth"].to_i, d["maxWidth"].to_i) && height.between?(d["minHeight"].to_i, d["maxHeight"].to_i) &&
        File.size(file) <= s["maxFileSize"].to_i
    end
    UI.user_error!("#{file}: #{width}×#{height} fits no #{placement_type} specification of App Store Connect – check npm run store:creative against appAssetLibraryRefData") unless spec
    spec
  end

  # The placement groups an image of this specification can go to on an App
  # Store version (one placement per group, e.g. iPhone and iPad).
  def creative_groups(placement_type, spec_id)
    type = creative_ref_data["placementTypes"].find { |t| t["placementTypeId"] == placement_type }
    UI.user_error!("App Store Connect knows no placement type #{placement_type}") unless type
    unless Array(type["acceptsAssetCategories"]).include?("CREATIVE_ASSETS")
      UI.user_error!("#{placement_type} does not accept CREATIVE_ASSETS (accepts #{Array(type["acceptsAssetCategories"]).join(", ")})")
    end
    groups = Array(type["specMappings"]).select { |m| Array(m["specs"]).include?(spec_id) }.map { |m| m["placementGroupId"] }
    feature = Array(creative_ref_data["features"]).find { |f| f["featureId"] == "APP_STORE_VERSIONS" }
    policy = feature && Array(feature["placementPolicies"]).find { |p| p["placementType"] == placement_type }
    if policy
      allowed = Array(policy["groupLimits"]).flat_map { |l| Array(l["groupIds"]) }
      groups &= allowed unless allowed.empty?
    end
    UI.user_error!("No placement group of #{placement_type} on App Store versions takes the specification #{spec_id}") if groups.empty?
    groups.uniq
  end

  # The image in the Asset Library, uploaded once per file content.
  def creative_image(library_id, file, reference)
    found = asc.get("v1/appAssetLibraries/#{library_id}/images", { filter: { referenceName: reference }, limit: 20 }).body["data"]
    found.each do |image|
      state = image.dig("attributes", "state")
      return image if CREATIVE_READY.include?(state) || state == "UPLOAD_COMPLETE"
      # An abandoned reservation or a failed processing: start over.
      UI.message("Removing #{reference} (#{state})")
      asc.delete("v1/appAssetLibraryImages/#{image["id"]}")
    end
    bytes = File.binread(file)
    UI.message("Uploading #{reference}")
    image = asc.post("v1/appAssetLibraryImages", {
      data: {
        type: "appAssetLibraryImages",
        attributes: { fileName: File.basename(file), fileSize: bytes.bytesize, category: "CREATIVE_ASSETS", referenceName: reference },
        relationships: { assetLibrary: { data: { type: "appAssetLibraries", id: library_id } } },
      },
    }).body["data"]
    Spaceship::ConnectAPI::FileUploader.upload(image.dig("attributes", "uploadOperations"), bytes)
    asc.patch("v1/appAssetLibraryImages/#{image["id"]}", { data: { type: "appAssetLibraryImages", id: image["id"], attributes: { uploaded: true } } })
    image
  end

  def creative_wait(image, reference)
    deadline = Time.now + 900
    loop do
      image = asc.get("v1/appAssetLibraryImages/#{image["id"]}").body["data"]
      state = image.dig("attributes", "state")
      return image if CREATIVE_READY.include?(state)
      if state == "FAILED" || state == "REJECTED"
        details = image.dig("attributes", "stateDetails").to_json
        asc.delete("v1/appAssetLibraryImages/#{image["id"]}") if state == "FAILED"
        UI.user_error!("#{reference}: #{state} #{details}")
      end
      UI.user_error!("#{reference}: still #{state} after 15 minutes – run again later") if Time.now > deadline
      UI.message("#{reference}: #{state}, waiting")
      sleep(10)
    end
  end

  # Header and search results image of every language on the version being
  # edited. Returns rows for the summary.
  def upload_creative
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app #{BUNDLE_ID} in App Store Connect") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    unless version
      manual_step("Creative assets: no version in preparation", [
        "Create the version #{package_version} (run iOS setup with listing on), then run it again with creative on –",
        "or upload store/app-store/creative/<locale>/*.png in App Store Connect → Asset Library (see store/README.md → Creative assets).",
      ])
      return []
    end
    localizations = version.get_app_store_version_localizations.to_h { |l| [l.locale, l] }
    library_id = asc.get("v1/apps/#{app.id}/assetLibrary").body.dig("data", "id")
    rows = []
    Dir[File.join(ROOT, "store/app-store/creative/*")].sort.each do |dir|
      locale = File.basename(dir)
      localization = localizations[locale]
      unless localization
        manual_step("Creative assets: version #{version.version_string} has no #{locale} localization", ["Upload the listing first (iOS setup with listing on), then run it again."])
        next
      end
      CREATIVE.each do |kind, placement_type|
        file = File.join(dir, "#{kind}.png")
        next unless File.exist?(file)
        spec = creative_spec(placement_type, file)
        reference = "Flowplan #{kind} #{locale} #{Digest::SHA256.file(file).hexdigest[0, 12]}"
        image = creative_wait(creative_image(library_id, file, reference), reference)
        UI.important("#{reference}: App Store Connect matched spec #{image.dig("attributes", "specId")}, expected #{spec["specId"]}") if image.dig("attributes", "specId") != spec["specId"]
        groups = creative_groups(placement_type, image.dig("attributes", "specId") || spec["specId"])
        placements = asc.get("v1/appStoreVersionLocalizations/#{localization.id}/placements", { filter: { placementType: placement_type }, include: "image", limit: 50 }).body["data"]
        groups.each do |group|
          existing = placements.select { |p| p.dig("attributes", "placementGroup") == group }
          if existing.any? { |p| p.dig("relationships", "image", "data", "id") == image["id"] }
            rows << "| #{locale} | #{kind} | #{group} | kept |"
            next
          end
          begin
            # One header (and one search results asset) per group: replace.
            existing.each { |p| asc.delete("v1/appAssetLibraryPlacements/#{p["id"]}") }
            asc.post("v1/appAssetLibraryPlacements", {
              data: {
                type: "appAssetLibraryPlacements",
                attributes: { placementType: placement_type, placementGroup: group },
                relationships: {
                  image: { data: { type: "appAssetLibraryImages", id: image["id"] } },
                  appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: localization.id } },
                },
              },
            })
            rows << "| #{locale} | #{kind} | #{group} | #{existing.empty? ? "placed" : "replaced"} |"
          rescue => e
            # Typically STATE_ERROR: the version is in review or approved.
            manual_step("Creative assets: #{locale} #{kind} (#{group}) could not be placed: #{asc_error(e)}", [
              "The image is in the Asset Library as \"#{reference}\".",
              "App Store Connect → Flowplan → the version → Header and Search Results → #{kind == "header" ? "Header" : "Search Results"} → Browse Assets → choose it → Save.",
            ])
          end
        end
      end
    end
    step_summary(["### Creative assets (version #{version.version_string})", "", "| Language | Asset | Placement group | |", "| --- | --- | --- | --- |", *rows].join("\n")) unless rows.empty?
    rows
  end

  desc "Product page header and search results image (store/app-store/creative) onto the version in preparation"
  lane :creative do
    upload_creative
    unless manual_steps.empty?
      UI.user_error!("#{manual_steps.size} manual step(s) left: #{manual_steps.map(&:first).join(" · ")}")
    end
  end

  # ---- iOS setup (Actions → iOS setup, store/README.md → One-click setup) ----
  #
  # Safe to run again: everything that exists is kept. What the API cannot do
  # (create the app record, register the App Group) is collected as a
  # "manual step" with the exact values; the rest of the run goes on, and the
  # lane fails at the end with that list, so the next run picks up from there.

  def manual_steps
    @manual_steps ||= []
  end

  def manual_step(title, lines)
    manual_steps << [title, lines]
    UI.important("Manual step: #{title}")
    lines.each { |line| UI.important("  #{line}") }
  end

  # Markdown for the run's summary page on GitHub.
  def step_summary(markdown)
    path = ENV["GITHUB_STEP_SUMMARY"].to_s
    File.open(path, "a") { |file| file.puts(markdown, "") } unless path.empty?
  end

  # App IDs of every target with their capabilities, through the App Store
  # Connect API (the key authorises Spaceship::ConnectAPI).
  def register_identifiers
    api_key
    rows = []
    IOS_TARGETS.each do |t|
      bundle = Spaceship::ConnectAPI::BundleId.find(t[:bundle_id])
      if bundle
        state = "exists"
      else
        UI.message("Registering the App ID #{t[:bundle_id]} (#{t[:name]})")
        bundle = Spaceship::ConnectAPI::BundleId.create(name: t[:name], platform: "IOS", identifier: t[:bundle_id])
        state = "registered"
      end
      present = bundle.get_capabilities
      added = t[:capabilities].reject { |type| present.any? { |capability| capability.is_type?(type) } }
      added.each do |type|
        UI.message("#{t[:bundle_id]}: turning on #{type}")
        bundle.create_capability(type)
      end
      rows << "| `#{t[:bundle_id]}` | #{state} | #{t[:capabilities].join(", ")}#{added.empty? ? "" : " (added: #{added.join(", ")})"} |"
    end
    step_summary(["### App IDs", "", "| App ID | State | Capabilities |", "| --- | --- | --- |", *rows].join("\n"))
  end

  # What a profile allows, compared with what the targets' entitlements
  # (app.config.ts) ask for: the App Group in all, push in the app.
  def profile_gaps
    IOS_TARGETS.flat_map do |t|
      path = match_profile_path(t[:bundle_id])
      next ["#{t[:bundle_id]}: no profile"] if path.empty? || !File.exist?(path)
      entitlements = FastlaneCore::ProvisioningProfile.parse(path).fetch("Entitlements", {})
      gaps = []
      gaps << "#{t[:bundle_id]}: App Group #{APP_GROUP} missing" unless Array(entitlements["com.apple.security.application-groups"]).include?(APP_GROUP)
      gaps << "#{t[:bundle_id]}: push (aps-environment) missing" if t[:capabilities].include?("PUSH_NOTIFICATIONS") && !entitlements.key?("aps-environment")
      gaps
    end
  end

  def app_group_step
    manual_step("Register the App Group and assign it to every App ID (the API cannot do this)", [
      "developer.apple.com → Certificates, Identifiers & Profiles → Identifiers → + → App Groups → Continue",
      "  Description: Flowplan · Identifier: #{APP_GROUP} → Continue → Register",
      "Identifiers → #{BUNDLE_ID} → App Groups → Configure → tick #{APP_GROUP} → Continue → Save → Confirm",
      "Identifiers → #{WIDGETS_ID} → App Groups → Configure → tick #{APP_GROUP} → Continue → Save → Confirm",
      "Identifiers → #{SHARE_ID} → App Groups → Configure → tick #{APP_GROUP} → Continue → Save → Confirm",
      "Identifiers → #{NOTIFICATIONS_ID} → App Groups → Configure → tick #{APP_GROUP} → Continue → Save → Confirm",
      "Then run Actions → iOS setup again: it renews the profiles by itself.",
    ])
  end

  # Certificate and profiles with match, allowed to create them. A profile
  # made before the App Group was assigned lacks it: then the profiles are
  # renewed once; if the group is still missing, it is a manual step.
  def setup_signing(force:)
    build_keychain
    match_signing(readonly: false, force: force)
    gaps = profile_gaps
    if !gaps.empty? && !force
      UI.important("The profiles lack: #{gaps.join("; ")} – renewing them")
      match_signing(readonly: false, force: true)
      gaps = profile_gaps
    end
    app_group_step if gaps.any? { |gap| gap.include?(APP_GROUP) }
    other = gaps.reject { |gap| gap.include?(APP_GROUP) }
    unless other.empty?
      manual_step("The profiles lack entitlements", [
        *other,
        "Check the App IDs' capabilities at developer.apple.com → Identifiers, then run iOS setup with force_profiles on.",
      ])
    end
    rows = IOS_TARGETS.map { |t| "| `#{t[:bundle_id]}` | #{match_profile_name(t[:bundle_id])} |" }
    step_summary(["### Signing (match, #{MATCH_GIT_URL})", "", "| App ID | Profile |", "| --- | --- |", *rows, "", gaps.empty? ? "Profiles include #{APP_GROUP} and push." : "Missing: #{gaps.join("; ")}"].join("\n"))
  ensure
    delete_build_keychain
  end

  # The app record in App Store Connect: the API cannot create it.
  def app_record?
    api_key
    return true if Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    name = File.read(File.join(ROOT, "store/app-store/#{PRIMARY_LOCALE}/name.txt")).strip
    other = File.read(File.join(ROOT, "store/app-store/de-DE/name.txt")).strip
    manual_step("Create the app in App Store Connect (the API cannot), then run iOS setup again", [
      "appstoreconnect.apple.com → Apps → + → New App",
      "  Platforms: iOS",
      "  Name: #{name}   (if the name is taken: #{other})",
      "  Primary Language: English (U.S.)",
      "  Bundle ID: Flowplan - #{BUNDLE_ID}",
      "  SKU: #{SKU}",
      "  User Access: Full Access",
      "→ Create. Texts, screenshots, age rating and review information follow on the next run.",
    ])
    false
  end

  desc "One-click App Store setup: App IDs, signing (match), app record check, listing, creative assets"
  lane :setup do |options|
    flag = ->(name, default) { options.key?(name) ? options[name].to_s == "true" : default }
    identifiers = flag.call(:identifiers, true)
    signing = flag.call(:signing, true)
    listing = flag.call(:listing, true)
    screenshots = flag.call(:screenshots, true)
    submit = flag.call(:submit, false)
    force = flag.call(:force_profiles, false)
    creative = flag.call(:creative, false)

    register_identifiers if identifiers
    if signing
      if match?
        begin
          setup_signing(force: force)
        rescue => e
          # The listing does not depend on signing: go on, report at the end.
          manual_step("Signing failed: #{e.message.lines.first.to_s.strip}", [
            "See the log above. Common causes: the API key is not Admin; the team already has",
            "the maximum of Apple Distribution certificates (revoke an unused one at",
            "developer.apple.com → Certificates); MATCH_GIT_BASIC_AUTHORIZATION cannot push to the repository.",
          ])
        end
      else
        manual_step("Signing skipped: create the secrets MATCH_PASSWORD and MATCH_GIT_BASIC_AUTHORIZATION", [
          "Settings → Secrets and variables → Actions (store/README.md → One-click setup)",
        ])
      end
    end
    if (listing || submit || creative) && app_record?
      # The listing creates the version and its localizations; the creative
      # assets go onto them before the version is submitted.
      if listing || submit
        upload_listing(screenshots: screenshots, submit: submit && !creative)
        step_summary("### Listing\n\nTexts, age rating, review information#{screenshots ? ", screenshots (iPhone 6.9\", 6.5\", iPad 13\")" : ""} uploaded for #{package_version}#{submit && !creative ? " and submitted for review" : " (not submitted)"}.")
      end
      if creative
        open_steps = manual_steps.size
        upload_creative
        # Submitted only when every asset is placed.
        if submit && manual_steps.size == open_steps
          upload_listing(screenshots: false, submit: true)
          step_summary("### Review\n\nVersion #{package_version} with its creative assets submitted for review.")
        end
      end
    end

    unless manual_steps.empty?
      step_summary((["### Still to do", ""] + manual_steps.flat_map { |title, lines| ["**#{title}**", "", "```", *lines, "```", ""] }).join("\n"))
      UI.user_error!("#{manual_steps.size} manual step(s) left: #{manual_steps.map(&:first).join(" · ")} – see above or the run's summary")
    end
    UI.success("iOS setup complete")
  end
end

platform :android do
  desc "Signed release bundle"
  lane :build do
    keystore = File.join(Dir.tmpdir, "flowplan-upload.jks")
    File.binwrite(keystore, decoded("ANDROID_KEYSTORE"))
    ENV["ANDROID_KEYSTORE_FILE"] = keystore
    env!("ANDROID_KEYSTORE_PASSWORD")
    env!("ANDROID_KEY_ALIAS")
    # Bundle for Play and an APK to install directly, both with the upload key.
    gradle(project_dir: File.join(ROOT, "android"), tasks: ["bundleRelease", "assembleRelease"], flags: "--no-daemon")
  ensure
    # The upload key does not stay on the build machine.
    File.delete(keystore) if keystore && File.exist?(keystore)
  end

  desc "Signed bundle to Play's internal testing track"
  lane :internal do
    build
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key_data: decoded("PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal",
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: File.join(ROOT, "android/app/build/outputs/bundle/release/app-release.aab"),
      metadata_path: File.join(ROOT, "store/google-play"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Play texts and images (store/google-play)"
  lane :metadata do
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key_data: decoded("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: File.join(ROOT, "store/google-play"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
    )
  end
end
