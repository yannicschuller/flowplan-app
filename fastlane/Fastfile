# Builds and uploads for the stores. Every lane works from the repository
# root after `npm ci && npx expo prebuild` (plus `pod install` for iOS);
# credentials come from the environment (README → Signing lists every secret):
#
#   fastlane ios build        signed App Store build (ios/build/Flowplan.ipa)
#   fastlane ios beta         … and upload it to TestFlight
#   fastlane ios metadata     texts and screenshots from store/app-store
#   fastlane android build    signed bundle and APK (android/app/build/outputs)
#   fastlane android internal … and upload it to Play's internal testing track
#   fastlane android metadata texts and images from store/google-play
#
# Without credentials the build workflow builds unsigned instead (no fastlane).
# The iOS app has two targets: the app (app.flowplan.mobile) and its widgets
# and Live Activity (app.flowplan.mobile.widgets), both in the App Group
# group.app.flowplan.mobile.

require "securerandom"

ROOT = File.expand_path("..", __dir__)
BUNDLE_ID = "app.flowplan.mobile"
WIDGETS_ID = "#{BUNDLE_ID}.widgets"
KEYCHAIN = "flowplan-build"
KEYCHAIN_PASSWORD = SecureRandom.hex(16)

def env!(name)
  value = ENV[name].to_s
  UI.user_error!("Missing #{name} (see README → Signing)") if value.empty?
  value
end

# A secret given as base64 or as plain text.
def decoded(name)
  value = env!(name).strip
  return value if value.start_with?("-----BEGIN", "{")
  require "base64"
  Base64.decode64(value)
end

platform :ios do
  def api_key
    @api_key ||= app_store_connect_api_key(
      key_id: env!("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: env!("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: decoded("APP_STORE_CONNECT_API_KEY"),
      in_house: false,
    )
  end

  # The key as a file, for xcodebuild's own sign-in (cloud signing).
  def api_key_file
    path = File.join(Dir.tmpdir, "AuthKey_#{env!("APP_STORE_CONNECT_API_KEY_ID")}.p8")
    File.write(path, decoded("APP_STORE_CONNECT_API_KEY"))
    path
  end

  desc "Signed App Store build"
  lane :build do
    api_key
    project = File.join(ROOT, "ios/Flowplan.xcodeproj")
    xcargs = ["-allowProvisioningUpdates"]
    export_options = {}
    if ENV["IOS_DISTRIBUTION_CERTIFICATE"].to_s != ""
      # Certificate and profiles from secrets: manual signing, one profile
      # per target.
      # A keychain of its own for this build, not the default one: the build
      # runs on a Mac that is also used otherwise (README → Build machine).
      certificate = File.join(Dir.tmpdir, "distribution.p12")
      File.binwrite(certificate, decoded("IOS_DISTRIBUTION_CERTIFICATE"))
      create_keychain(
        name: KEYCHAIN,
        password: KEYCHAIN_PASSWORD,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: true,
        add_to_search_list: true,
      )
      import_certificate(
        certificate_path: certificate,
        certificate_password: ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"].to_s,
        keychain_name: KEYCHAIN,
        keychain_password: KEYCHAIN_PASSWORD,
      )
      File.delete(certificate)
      profiles = {
        "Flowplan" => [BUNDLE_ID, "IOS_PROVISIONING_PROFILE", ENV.fetch("IOS_PROVISIONING_PROFILE_NAME", "Flowplan App Store")],
        "ExpoWidgetsTarget" => [WIDGETS_ID, "IOS_WIDGETS_PROVISIONING_PROFILE", ENV.fetch("IOS_WIDGETS_PROVISIONING_PROFILE_NAME", "Flowplan Widgets App Store")],
      }
      profiles.each do |target, (bundle_id, secret, name)|
        profile = File.join(Dir.tmpdir, "#{target}.mobileprovision")
        File.binwrite(profile, decoded(secret))
        install_provisioning_profile(path: profile)
        update_code_signing_settings(
          path: project,
          targets: [target],
          use_automatic_signing: false,
          team_id: env!("IOS_TEAM_ID"),
          code_sign_identity: "Apple Distribution",
          profile_name: name,
          bundle_identifier: bundle_id,
        )
        export_options[bundle_id] = name
      end
    else
      # Only the API key: Xcode signs with cloud-managed certificates and
      # creates the App IDs, the App Group and the profiles itself.
      xcargs += [
        "-authenticationKeyPath #{api_key_file}",
        "-authenticationKeyID #{env!("APP_STORE_CONNECT_API_KEY_ID")}",
        "-authenticationKeyIssuerID #{env!("APP_STORE_CONNECT_API_ISSUER_ID")}",
        "DEVELOPMENT_TEAM=#{env!("IOS_TEAM_ID")}",
        "CODE_SIGN_STYLE=Automatic",
      ]
    end
    build_app(
      workspace: File.join(ROOT, "ios/Flowplan.xcworkspace"),
      scheme: "Flowplan",
      configuration: "Release",
      export_method: "app-store",
      export_options: export_options.empty? ? {} : { provisioningProfiles: export_options },
      output_directory: File.join(ROOT, "ios/build"),
      output_name: "Flowplan.ipa",
      xcargs: xcargs.join(" "),
      export_xcargs: "-allowProvisioningUpdates",
    )
  ensure
    delete_keychain(name: KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db"))
  end

  desc "Signed build to TestFlight (internal testers)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ROOT, "ios/build/Flowplan.ipa"),
      skip_waiting_for_build_processing: true,
      changelog: File.read(File.join(ROOT, "store/app-store/en-US/release_notes.txt")),
    )
  end

  # What App Review gets besides store/app-store/review_information/*.txt: the
  # demo account and the contact, from the environment and never from files in
  # the repository (store/README.md → App Review).
  def review_information
    values = {
      demo_user: ENV["DEMO_USER"],
      demo_password: ENV["DEMO_PASSWORD"],
      email_address: ENV["REVIEW_EMAIL"],
      phone_number: ENV["REVIEW_PHONE"],
    }.reject { |_, value| value.to_s.strip.empty? }
    UI.important("No DEMO_USER / DEMO_PASSWORD set: App Review gets no demo account from this upload.") unless values[:demo_user] && values[:demo_password]
    values
  end

  desc "App Store texts and screenshots (store/app-store); the review is submitted by hand"
  lane :metadata do
    deliver(
      api_key: api_key,
      metadata_path: File.join(ROOT, "store/app-store"),
      screenshots_path: File.join(ROOT, "store/app-store/screenshots"),
      app_review_information: review_information,
      skip_binary_upload: true,
      skip_app_version_update: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end

platform :android do
  desc "Signed release bundle"
  lane :build do
    keystore = File.join(Dir.tmpdir, "flowplan-upload.jks")
    File.binwrite(keystore, decoded("ANDROID_KEYSTORE"))
    ENV["ANDROID_KEYSTORE_FILE"] = keystore
    env!("ANDROID_KEYSTORE_PASSWORD")
    env!("ANDROID_KEY_ALIAS")
    # Bundle for Play and an APK to install directly, both with the upload key.
    gradle(project_dir: File.join(ROOT, "android"), tasks: ["bundleRelease", "assembleRelease"], flags: "--no-daemon")
  ensure
    # The upload key does not stay on the build machine.
    File.delete(keystore) if keystore && File.exist?(keystore)
  end

  desc "Signed bundle to Play's internal testing track"
  lane :internal do
    build
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key_data: decoded("PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal",
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: File.join(ROOT, "android/app/build/outputs/bundle/release/app-release.aab"),
      metadata_path: File.join(ROOT, "store/google-play"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Play texts and images (store/google-play)"
  lane :metadata do
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key_data: decoded("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: File.join(ROOT, "store/google-play"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
    )
  end
end
